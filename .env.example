# ─────────────────────────────────────────────────────────────
# Citrineland CRM — environment variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# PostgreSQL 16 connection string. DO Managed Database: append ?sslmode=require
DATABASE_URL=postgresql://citrineland:citrineland@localhost:5432/citrineland
# Only used when running Postgres inside Compose (--profile localdb)
POSTGRES_PASSWORD=citrineland

# Public base URL of the app (used for links in emails, unsubscribe, OAuth redirects)
APP_URL=http://localhost:3000
# Domain Caddy serves with automatic HTTPS (production), e.g. crm.citrineland.com
APP_DOMAIN=localhost

# ── Auth.js ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Same as APP_URL in production
AUTH_URL=http://localhost:3000
# Microsoft Entra ID (see docs/MICROSOFT_SETUP.md). Leave blank to disable SSO.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<TENANT_ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Bootstrap Admin (password login fallback). Used by the seed script.
BOOTSTRAP_ADMIN_EMAIL=admin@citrineland.com
BOOTSTRAP_ADMIN_PASSWORD=
# DEV/DEMO ONLY: allow the seeded demo users to sign in with the bootstrap password. Must be false in production.
DEMO_PASSWORD_LOGIN=false
# Seed demo data (developments, leads, transactions…) when running the seed. Set false for production.
SEED_DEMO=true
# Run migrations + seed on container start (compose `migrate` service). Use true only for first deploy/demo.
SEED_ON_START=false

# ── Encryption ──
# 32 random bytes, base64. Encrypts Microsoft refresh tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ── DigitalOcean Spaces (S3-compatible) ──
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_REGION=sgp1
SPACES_BUCKET=citrineland-crm
SPACES_KEY=
SPACES_SECRET=
# Leave blank to store files on local disk (dev only) under ./.uploads
LOCAL_UPLOAD_DIR=

# ── Public web lead form ──
# Cloudflare Turnstile keys (CAPTCHA). Leave blank in dev to skip CAPTCHA verification.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Which sites may embed the hosted form in an iframe (CSP frame-ancestors), space-separated
PUBLIC_FORM_FRAME_ANCESTORS=https://www.citrineland.com

# ── Backups (only if PostgreSQL is self-hosted on the Droplet) ──
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=30

# ── Observability ──
LOG_LEVEL=info
